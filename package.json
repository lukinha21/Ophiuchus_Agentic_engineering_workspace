{
  "name": "ophiuchus-pilot",
  "private": true,
  "version": "2.14.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:studio": "vite build --config vite.studio.config.mjs --configLoader runner && vite preview --config vite.studio.config.mjs --configLoader runner",
    "test:runtime": "node --test runtime/*.test.mjs",
    "api": "node runtime/server.mjs",
    "desktop": "electron .",
    "desktop:icons": "node desktop/create-icon.mjs",
    "desktop:package": "node desktop/package.mjs",
    "test:desktop": "node --test runtime/desktop-host.test.mjs runtime/desktop-worker.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "45.3.2",
    "esbuild": "0.28.2"
  },
  "main": "desktop/main.cjs",
  "productName": "Ophiuchus",
  "description": "Ophiuchus — estúdio desktop de engenharia multiagente"
}
